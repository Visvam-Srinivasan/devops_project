# Copy this file to docker/.env and fill in your own GitHub repo URL
# (the one you pushed this project to — Jenkins clones from it).
GIT_REPO_URL=https://github.com/CHANGE-ME/devops_project.git

# Optional — defaults to admin123 if unset. This Jenkins is never exposed
# outside localhost, so a simple demo password is fine.
JENKINS_ADMIN_PASSWORD=admin123
